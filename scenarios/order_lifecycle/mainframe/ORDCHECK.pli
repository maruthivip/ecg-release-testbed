ORDCHECK: PROCEDURE OPTIONS(MAIN);
    DECLARE INFILE FILE INPUT RECORD;
    DECLARE CHECKOUT FILE OUTPUT RECORD;
    DECLARE ORDER_RECORD CHARACTER(80);
    OPEN FILE(INFILE) INPUT;
    OPEN FILE(CHECKOUT) OUTPUT;
    READ FILE(INFILE) INTO(ORDER_RECORD);
    WRITE FILE(CHECKOUT) FROM(ORDER_RECORD);
    CLOSE FILE(INFILE);
    CLOSE FILE(CHECKOUT);
END ORDCHECK;
