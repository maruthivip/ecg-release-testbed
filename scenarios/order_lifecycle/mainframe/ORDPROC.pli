ORDPROC: PROCEDURE OPTIONS(MAIN);
    DECLARE INFILE FILE INPUT RECORD;
    DECLARE OUTFILE FILE OUTPUT RECORD;
    DECLARE ORDER_RECORD CHARACTER(80);
    OPEN FILE(INFILE) INPUT;
    OPEN FILE(OUTFILE) OUTPUT;
    READ FILE(INFILE) INTO(ORDER_RECORD);
    WRITE FILE(OUTFILE) FROM(ORDER_RECORD);
    CLOSE FILE(INFILE);
    CLOSE FILE(OUTFILE);
END ORDPROC;
